# Copiar a dev.env y completar. dev.env NO se versiona.
AMBIENTE=dev
HEADLESS=true

# URL base de la aplicación bajo prueba
APP_BASE_URL=https://mi-app.example.com/
# Ruta del formulario de login (relativa a APP_BASE_URL)
APP_LOGIN_PATH=/

# Credenciales del perfil @perfil_admin
APP_ADMIN_USER=
APP_ADMIN_PASSWORD=
